{
    "name": "ernestdefoe/rubric",
    "description": "Thread prefixes for Flarum 2: a short coloured label before a discussion's title — [Rumor], [Official], [Solved] — chosen when the discussion is started, separate from tags.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "prefix",
        "thread-prefix",
        "label"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/ernestdefoe/rubric",
    "support": {
        "forum": "https://discuss.flarum.org/d/39988-rubric",
        "issues": "https://github.com/ernestdefoe/rubric/issues",
        "source": "https://github.com/ernestdefoe/rubric"
    },
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/tags": "Limit a prefix to some tags, and require a prefix in others."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Rubric\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Rubric\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Rubric",
            "category": "feature",
            "icon": {
                "name": "fas fa-bookmark",
                "backgroundColor": "#b45309",
                "color": "#fff"
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
